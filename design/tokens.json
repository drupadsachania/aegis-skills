{
  "$description": "Kairos design tokens (W3C Design Tokens format). Source of truth: edit this file, then run `node design/build-tokens.js` to regenerate tokens.css. Light is the default; dark applies only under :root[data-theme=\"dark\"] (no prefers-color-scheme auto-dark: owner decision).",
  "color": {
    "$type": "color",
    "light": {
      "bg":            { "$value": "#FEF9ED", "$description": "Page paper" },
      "surface":       { "$value": "#F7F1E3", "$description": "Cards, panels" },
      "surface-raised":{ "$value": "#F7ECD9", "$description": "Hover rows, inset wells, secondary buttons" },
      "text":          { "$value": "#3A312B", "$description": "Headings and strong text" },
      "text-muted":    { "$value": "#5D524B", "$description": "Body copy, secondary text" },
      "text-subtle":   { "$value": "#6E6259", "$description": "Captions, metadata (still AA)" },
      "border":        { "$value": "#8C7F73", "$description": "Control borders (3:1 non-text)" },
      "line":          { "$value": "#D9CFBA", "$description": "Decorative hairlines and dividers only" },
      "foundation":    { "$value": "#3A312B", "$description": "PLACEHOLDER Kairos Foundation accent: neutral ink. Replace when the Foundation picks its own colour." },
      "foundation-hover": { "$value": "#4E433B" },
      "on-foundation": { "$value": "#FEF9ED" },
      "aegis":         { "$value": "#E8B93C", "$description": "Gold FILL only. Never text on cream." },
      "aegis-hover":   { "$value": "#F0C752" },
      "aegis-ink":     { "$value": "#7A5600", "$description": "Gold-toned text and icons on cream" },
      "aegis-soft":    { "$value": "#F6E7B8" },
      "on-aegis":      { "$value": "#3A312B" },
      "themis":        { "$value": "#2F4FD8", "$description": "Blue: text, links, fills" },
      "themis-hover":  { "$value": "#243FB8" },
      "themis-soft":   { "$value": "#E4E9FA" },
      "on-themis":     { "$value": "#FFFFFF" },
      "link":          { "$value": "#2F4FD8" },
      "focus":         { "$value": "#2F4FD8" },
      "success":       { "$value": "#1B6B3A" },
      "success-bg":    { "$value": "#E3F1E6" },
      "warning":       { "$value": "#8A5A00" },
      "warning-bg":    { "$value": "#FBEBC8" },
      "danger":        { "$value": "#B42318" },
      "danger-bg":     { "$value": "#FBE3DF" },
      "nav-bg":        { "$value": "rgba(254, 249, 237, 0.78)" },
      "overlay":       { "$value": "rgba(58, 49, 43, 0.45)" },
      "shadow-ink":    { "$value": "rgba(58, 49, 43, 0.22)" },
      "code-bg":       { "$value": "#2A241F", "$description": "Terminal / code window stays dark in both themes" },
      "code-text":     { "$value": "#F0E8D4" },
      "plate":         { "$value": "#FEF9ED", "$description": "Logo plate: cream behind raster logos and SVG icons. Identical in both themes so the brown ink strokes always sit on cream." }
    },
    "dark": {
      "bg":            { "$value": "#020E1C" },
      "surface":       { "$value": "#051A2E" },
      "surface-raised":{ "$value": "#0A2540" },
      "text":          { "$value": "#F0E8D4" },
      "text-muted":    { "$value": "#C9C0AB" },
      "text-subtle":   { "$value": "#9A9384" },
      "border":        { "$value": "#6F7F92" },
      "line":          { "$value": "#1E3148" },
      "foundation":    { "$value": "#F0E8D4", "$description": "PLACEHOLDER Foundation accent (dark): cream ink." },
      "foundation-hover": { "$value": "#FFFFFF" },
      "on-foundation": { "$value": "#020E1C" },
      "aegis":         { "$value": "#E3BD48" },
      "aegis-hover":   { "$value": "#EFCB5A" },
      "aegis-ink":     { "$value": "#E3BD48" },
      "aegis-soft":    { "$value": "#1D2321" },
      "on-aegis":      { "$value": "#020E1C" },
      "themis":        { "$value": "#9C9AF0" },
      "themis-hover":  { "$value": "#B3B1F6" },
      "themis-soft":   { "$value": "#18223A" },
      "on-themis":     { "$value": "#020E1C" },
      "link":          { "$value": "#9C9AF0" },
      "focus":         { "$value": "#E3BD48" },
      "success":       { "$value": "#6FCF8A" },
      "success-bg":    { "$value": "#0E2A1A" },
      "warning":       { "$value": "#E3B341" },
      "warning-bg":    { "$value": "#2B2208" },
      "danger":        { "$value": "#FF8A80" },
      "danger-bg":     { "$value": "#341514" },
      "nav-bg":        { "$value": "rgba(2, 14, 28, 0.78)" },
      "overlay":       { "$value": "rgba(0, 0, 0, 0.6)" },
      "shadow-ink":    { "$value": "rgba(0, 0, 0, 0.55)" },
      "code-bg":       { "$value": "#0A1626" },
      "code-text":     { "$value": "#F0E8D4" },
      "plate":         { "$value": "#FEF9ED", "$description": "Same cream as light: logos are drawn for light backgrounds and are never placed bare on navy." }
    }
  },
  "brand": {
    "$type": "color",
    "$description": "Logo artwork colours, taken from the owner's logos. Use them for fills and artwork only, never for UI text or thin strokes: gold and blue do not reach 4.5:1 on cream. UI accents (aegis, aegis-ink, themis) are separate, contrast-checked tokens.",
    "gold":  { "$value": "#D4AF37", "$description": "Aegis artwork gold" },
    "blue":  { "$value": "#0080FF", "$description": "Themis artwork blue" },
    "ink":   { "$value": "#5D524B", "$description": "Logo ink (brown); equals the text-muted token" },
    "paper": { "$value": "#FAF8F3", "$description": "Logo paper (off-white used inside icons)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "\"teimer-web\", Georgia, \"Times New Roman\", serif", "$description": "Adobe Fonts kit pww4pkx (see docs/design/FONTS.md). Headings: 300, italic 300 for the accent phrase, 600 for strong emphasis only." },
      "body":    { "$value": "\"legitima\", Georgia, \"Times New Roman\", serif", "$description": "Adobe Fonts kit pww4pkx. Running text at weight 500 (italic 500)." },
      "mono":    { "$value": "\"Red Hat Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace", "$description": "Self-hosted (OFL), weights 400 and 500." }
    },
    "size": {
      "$type": "dimension",
      "display-xl": { "$value": "clamp(2.75rem, 1.6rem + 5.2vw, 5.5rem)" },
      "display":    { "$value": "clamp(2.25rem, 1.5rem + 3.4vw, 3.75rem)" },
      "h2":         { "$value": "clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem)" },
      "h3":         { "$value": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)" },
      "h4":         { "$value": "1.25rem" },
      "body-l":     { "$value": "1.125rem" },
      "body":       { "$value": "1rem" },
      "small":      { "$value": "0.875rem" },
      "label":      { "$value": "0.75rem" },
      "app-body":   { "$value": "0.875rem", "$description": "Dashboard base size" },
      "app-small":  { "$value": "0.8125rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "light":   { "$value": 300, "$description": "teimer-web display weight" },
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "semibold":{ "$value": 600 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.025em" },
      "heading": { "$value": "-0.015em" },
      "body":    { "$value": "0" },
      "label":   { "$value": "0.08em" }
    },
    "leading": {
      "$type": "number",
      "display": { "$value": 1.08 },
      "heading": { "$value": 1.18 },
      "body":    { "$value": 1.58 },
      "ui":      { "$value": 1.4 },
      "code":    { "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.5rem" },
    "6":  { "$value": "2rem" },
    "7":  { "$value": "3rem" },
    "8":  { "$value": "4rem" },
    "9":  { "$value": "6rem" },
    "10": { "$value": "8rem" },
    "gutter": { "$value": "clamp(1.25rem, 4vw, 3rem)" },
    "section": { "$value": "clamp(4rem, 8vw, 8rem)" }
  },
  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "8px" },
    "md":   { "$value": "12px" },
    "lg":   { "$value": "20px" },
    "xl":   { "$value": "28px" },
    "2xl":  { "$value": "36px" },
    "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm":    { "$value": "0 1px 2px var(--k-color-shadow-ink)" },
    "md":    { "$value": "0 8px 24px -12px var(--k-color-shadow-ink)" },
    "lift":  { "$value": "0 14px 32px -14px var(--k-color-shadow-ink)" },
    "press": { "$value": "inset 0 1px 3px var(--k-color-shadow-ink)" },
    "ring":  { "$value": "0 0 0 3px var(--k-color-bg), 0 0 0 5px var(--k-color-focus)" }
  },
  "layout": {
    "$type": "dimension",
    "container":   { "$value": "75rem" },
    "container-app": { "$value": "80rem" },
    "prose":       { "$value": "42.5rem" },
    "sidebar":     { "$value": "15rem" },
    "sidebar-docs":{ "$value": "17.5rem" },
    "nav-height":  { "$value": "4rem" },
    "bp-sm":       { "$value": "30rem" },
    "bp-md":       { "$value": "48rem" },
    "bp-lg":       { "$value": "64rem" },
    "bp-xl":       { "$value": "80rem" },
    "bp-2xl":      { "$value": "96rem" },
    "target-min":  { "$value": "2.75rem" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant":  { "$value": "80ms" },
      "fast":     { "$value": "150ms" },
      "base":     { "$value": "240ms" },
      "moderate": { "$value": "360ms" },
      "slow":     { "$value": "600ms" },
      "reveal":   { "$value": "720ms" },
      "stagger":  { "$value": "60ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
      "smooth":     { "$value": "cubic-bezier(0.22, 1, 0.36, 1)" },
      "arrival":    { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "fold":       { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
    }
  },
  "z": {
    "$type": "number",
    "base":     { "$value": 0 },
    "raised":   { "$value": 10 },
    "sticky":   { "$value": 100 },
    "nav":      { "$value": 200 },
    "dropdown": { "$value": 300 },
    "overlay":  { "$value": 400 },
    "modal":    { "$value": 500 },
    "toast":    { "$value": 600 },
    "skip":     { "$value": 1000 }
  },
  "$extensions": {
    "kairos.brand": [
      { "token": "gold",  "usage": "fill-only", "on": "plate", "ratio": 2.0,  "rule": "max", "limit": 3,   "note": "1.98:1 on logo paper, 2.00:1 on the plate: artwork and fills only, never text or hairlines" },
      { "token": "blue",  "usage": "fill-only", "on": "plate", "ratio": 3.61, "rule": "max", "limit": 4.5, "note": "3.58:1 on logo paper, 3.61:1 on the plate: below AA for text; use the themis token for blue text and links" },
      { "token": "ink",   "usage": "text-ok",   "on": "plate", "ratio": 7.21, "rule": "min", "limit": 7,   "note": "7.13:1 on logo paper, 7.21:1 on the plate; on navy only 2.56:1, so raster logos need the cream plate in dark" },
      { "token": "paper", "usage": "fill-only", "on": "plate", "ratio": 1.01, "rule": "max", "limit": 1.2, "note": "inside-icon highlight, nearly the same as the plate" }
    ],
    "kairos.contrast": [
      { "fg": "text",       "bg": "bg",             "min": 7,   "note": "headings on page" },
      { "fg": "text",       "bg": "surface",        "min": 7 },
      { "fg": "text",       "bg": "surface-raised", "min": 7 },
      { "fg": "text-muted", "bg": "bg",             "min": 4.5, "note": "body copy" },
      { "fg": "text-muted", "bg": "surface",        "min": 4.5 },
      { "fg": "text-muted", "bg": "surface-raised", "min": 4.5 },
      { "fg": "text-subtle","bg": "bg",             "min": 4.5, "note": "captions" },
      { "fg": "text-subtle","bg": "surface",        "min": 4.5 },
      { "fg": "border",     "bg": "bg",             "min": 3,   "note": "control border, WCAG 1.4.11" },
      { "fg": "border",     "bg": "surface",        "min": 3 },
      { "fg": "on-foundation","bg": "foundation",   "min": 7 },
      { "fg": "on-foundation","bg": "foundation-hover","min": 7 },
      { "fg": "on-aegis",   "bg": "aegis",          "min": 4.5, "note": "label on gold fill" },
      { "fg": "on-aegis",   "bg": "aegis-hover",    "min": 4.5 },
      { "fg": "aegis-ink",  "bg": "bg",             "min": 4.5, "note": "gold-toned text" },
      { "fg": "aegis-ink",  "bg": "surface",        "min": 4.5 },
      { "fg": "aegis-ink",  "bg": "aegis-soft",     "min": 4.5 },
      { "fg": "on-themis",  "bg": "themis",         "min": 4.5 },
      { "fg": "on-themis",  "bg": "themis-hover",   "min": 4.5 },
      { "fg": "themis",     "bg": "bg",             "min": 4.5, "note": "blue text / links" },
      { "fg": "themis",     "bg": "surface",        "min": 4.5 },
      { "fg": "themis",     "bg": "themis-soft",    "min": 4.5 },
      { "fg": "link",       "bg": "bg",             "min": 4.5 },
      { "fg": "focus",      "bg": "bg",             "min": 3,   "note": "focus indicator, WCAG 2.4.11/1.4.11" },
      { "fg": "focus",      "bg": "surface",        "min": 3 },
      { "fg": "success",    "bg": "bg",             "min": 4.5 },
      { "fg": "success",    "bg": "success-bg",     "min": 4.5 },
      { "fg": "warning",    "bg": "bg",             "min": 4.5 },
      { "fg": "warning",    "bg": "warning-bg",     "min": 4.5 },
      { "fg": "danger",     "bg": "bg",             "min": 4.5 },
      { "fg": "danger",     "bg": "danger-bg",      "min": 4.5 },
      { "fg": "code-text",  "bg": "code-bg",        "min": 7 }
    ],
    "kairos.contrast.lightOnly": [
      { "fg": "aegis", "bg": "bg", "max": 2, "note": "documents the rule: gold is a fill, never text, on cream (ratio ~1.75:1)" }
    ]
  }
}
