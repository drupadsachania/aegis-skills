{
  "osk": "1.1",
  "name": "infrastructure-security",
  "version": "1.1.0",
  "description": "Infrastructure security assessment workflow covering asset discovery, configuration baseline, patch management, hardening controls, and compliance validation. Use for CIS Benchmark assessments, cloud security posture reviews, or infrastructure hardening sprints.",
  "family": "domain",
  "frameworks": [
    "cis-benchmarks",
    "nist-csf",
    "mitre-attack"
  ],
  "tags": [
    "security",
    "infrastructure",
    "hardening",
    "patch-management",
    "compliance",
    "cloud"
  ],
  "phases": [
    {
      "id": "asset-discovery",
      "file": "references/asset-discovery.md",
      "tokens": 556
    },
    {
      "id": "configuration-baseline",
      "file": "references/configuration-baseline.md",
      "tokens": 584
    },
    {
      "id": "patch-management",
      "file": "references/patch-management.md",
      "tokens": 645
    },
    {
      "id": "hardening-controls",
      "file": "references/hardening-controls.md",
      "tokens": 651
    },
    {
      "id": "compliance-validation",
      "file": "references/compliance-validation.md",
      "tokens": 610
    },
    {
      "id": "live-threat-intel",
      "file": "references/live-threat-intel.md",
      "tokens": 444,
      "auto": true
    }
  ],
  "research": {
    "feeds": [
      "nvd-cve-feed",
      "cisa-kev",
      "cis-benchmarks"
    ],
    "red-team": false
  },
  "self-learning": {
    "update-frequency": "weekly",
    "sources": [
      "nvd-cve-feed",
      "cisa-kev",
      "cis-benchmarks-updates"
    ],
    "health-score": 1,
    "stale-threshold-days": 60,
    "coverage-gaps": [
      "CVEs referenced this period: CVE-2026-59310 — verify whether this estate is exposed",
      "Dominant themes: cloud (x3) — confirm controls address the recurring mechanism, not just individual incidents"
    ],
    "last-intel-sync": "2026-08-22",
    "intel-window-days": 7,
    "items-routed": 5,
    "teardowns-routed": 0
  },
  "context": {
    "environments": [
      "enterprise",
      "cloud",
      "hybrid",
      "on-premises"
    ],
    "industry-verticals": [
      "financial-services",
      "healthcare",
      "government",
      "retail",
      "manufacturing"
    ],
    "attack-surface-tags": [
      "servers",
      "cloud-workloads",
      "containers",
      "configuration",
      "patch-management"
    ]
  }
}
