{
  "name": "aegis-skills-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Aegis security skill pack, Themis security-operations agent and the aegis-skills website.",
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/drupadsachania/aegis-skills"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @aegis-skills/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @aegis-skills/web",
    "test": "jest",
    "skill-health": "node scripts/skill-health.js",
    "intel-sync": "node scripts/intel-sync.js",
    "check:layout": "node scripts/check-layout.js",
    "lint:skills": "node scripts/lint-skills.js",
    "skills:tokens": "node scripts/sync-skill-tokens.js",
    "skills:migrate": "node scripts/migrate-skill-frontmatter.js",
    "build:prompts": "node scripts/build-flat-prompts.js",
    "atlas:check": "node scripts/check-atlas-ids.js",
    "check:deps": "node scripts/check-deps.js"
  },
  "devDependencies": {
    "@swc/core": "1.7.0",
    "@swc/jest": "0.2.36",
    "jest": "^29.7.0"
  }
}
