{
  "schema": "mcp/1.0",
  "name": "threat-intel-synthesis",
  "version": "1.0.0",
  "description": "Turn raw threat intelligence — news feeds, knowledge graphs, vendor advisories, and incident teardowns — into structured attack patterns, reconstructed incident narratives, and attack-surface coverage maps that drive detection and control decisions. Triggers for: threat intel analysis, attack pattern extraction, incident reconstruction, \"what actually happened\" analysis, ATT&CK mapping from reporting, threat landscape review, coverage gap analysis, intel-driven detection engineering, or weekly threat recap.\n",
  "tools": [
    {
      "name": "invoke",
      "description": "Run a phase of the threat-intel-synthesis skill workflow",
      "inputSchema": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "description": "Phase ID to load",
            "enum": [
              "intel-ingestion",
              "attack-pattern-extraction",
              "incident-reconstruction",
              "attack-surface-coverage",
              "intel-to-detection",
              "continuous-learning-loop",
              "live-threat-intel"
            ]
          }
        }
      }
    }
  ],
