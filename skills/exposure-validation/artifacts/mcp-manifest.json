{
  "schema": "mcp/1.0",
  "name": "exposure-validation",
  "version": "1.0.0",
  "description": "Continuous exposure validation (CTEM) — prove which vulnerabilities are actually exposed, exploitable and impactful in an authorized environment, then prove the exploit window is closed after remediation. Treats vulnerability, exposure, exploitability, impact, detection, remediation and verification as independent evidence-backed states. Triggers for: exposure management programme design, CTEM, breach and attack simulation planning, validating scanner findings, KEV rapid response, attack-path impact analysis, remediation verification, retesting, or proving risk reduction to leadership.\n",
  "tools": [
    {
      "name": "invoke",
      "description": "Run a phase of the exposure-validation skill workflow",
      "inputSchema": {
        "type": "object",
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "description": "Phase ID to load",
            "enum": [
              "exposure-state-model",
              "validation-authorization-and-scope",
              "impact-and-attack-paths",
              "evidence-and-confidence",
              "remediation-verification",
              "rapid-exposure-response"
            ]
          }
        }
      }
    }
  ],
